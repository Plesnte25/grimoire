# Every entry must already be in your library (it needs a Work): add titles you
# haven't started with status PLANNED first, or the loader fails with "unknown work".
# `name` is only used if the franchise doesn't exist yet; an existing title wins.
# Copy to <name>.yaml to have it loaded by `node dist/scripts/curateFranchise.js`.
# `franchise` is the Franchise id (AniList id of the root series). A work is its
# id or "<source>:<externalId>" for any ExternalId: anilist:16498, mal:16498,
# imdb:tt0944947, and TMDB ids are namespaced: tmdb:tv:1429 / tmdb:movie:1429.
# A prerequisite must be another entry below and always blocks its dependent,
# even when the prerequisite itself is isEssential: false (the loader warns).
name: Example Franchise
franchise: "16498"
entries:
  - work: anilist:16498
    relation: main
    narrativeOrder: 1
  - work: anilist:25777
    relation: sequel
    narrativeOrder: 2
    prerequisite: anilist:16498
  - work: anilist:18397
    relation: ova
    isEssential: false
