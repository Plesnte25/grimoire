PORT=5050
# Interface to listen on. Defaults to 127.0.0.1 (only Caddy, on the same box, should reach it).
HOST=""
DATABASE_URL="file:./dev.db"
TMDB_API_KEY=""
# Optional: without it Google Books shares an anonymous quota and often answers 429.
GOOGLE_BOOKS_API_KEY=""
# Optional: IMDb, Rotten Tomatoes and Metacritic scores (free key at omdbapi.com).
OMDB_API_KEY=""

# Auth email (OTP codes sent via Gmail SMTP — requires 2FA + an App Password)
SMTP_USER=""
SMTP_APP_PASSWORD=""

# Comma-separated list of allowed frontend origins for CORS (leave unset to allow all, e.g. in dev)
FRONTEND_ORIGIN=""
