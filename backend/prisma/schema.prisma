generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MediaItem {
  id               String      @id @default(cuid())
  mediaType        String
  format           String?
  isAdult          Boolean?
  episodes         Int?
  duration         Int?      
  provider         String
  providerId       String
  title            String
  nativeTitle      String?
  year             Int?
  description      String?
  posterUrl        String?
  backdropUrl      String?

  // global rating info (provider-based)
  globalRating     Float?
  globalRatingText String?

  // your tracking
  status           String      @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, ON_HOLD, DROPPED
  yourRating       Float?
  yourNotes        String?

  // progress (generic + type-specific optional fields)
  progressText     String?      // e.g. "S2E5", "Page 123", "Listened 10x"
  progressValue    Int?         // numeric progress optional

  genres           String?      // JSON string array
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Franchise/series grouping ("card stack") — best-effort, provider-sourced.
  // Movies: TMDB belongs_to_collection. Anime: AniList prequel-chain root.
  // Music: iTunes album (collectionId). Books/TV: left null, no reliable signal.
  collectionId     String?
  collectionName   String?
  collectionSource String?      // "tmdb" | "anilist" | "itunes"

  listItems        ListItem[]

  @@unique([provider, providerId])
  @@index([collectionId])
}

model CustomList {
  id          String     @id @default(cuid())
  name        String
  description String?
  coverColor  String?    // hex or css token
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items       ListItem[]
}

model ListItem {
  id         String    @id @default(cuid())
  listId     String
  mediaId    String
  order      Int       @default(0)
  createdAt  DateTime  @default(now())

  list       CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media      MediaItem  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
}

// --- Auth (single-account: PIN unlock on trusted devices, email OTP to trust a new device) ---

model AccountConfig {
  id                Int       @id @default(1)
  email             String
  pinSaltHex        String
  pinHashHex        String
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TrustedDevice {
  id         String   @id @default(cuid()) // stored in long-lived httpOnly cookie `mv_device`
  label      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid()) // stored in httpOnly cookie `mv_session`
  deviceId  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model OtpCode {
  id              String    @id @default(cuid())
  codeHash        String
  pendingDeviceId String    // stored in short-lived httpOnly cookie `mv_pending_device`
  expiresAt       DateTime
  consumedAt      DateTime?
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now())
}
