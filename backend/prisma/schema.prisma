generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MediaItem {
  id          String   @id @default(cuid())
  mediaType   String
  format      String?
  isAdult     Boolean?
  episodes    Int?
  duration    Int? // minutes (per episode for series)
  provider    String // "tmdb" | "anilist" | "googlebooks" | "manual"
  providerId  String
  title       String
  nativeTitle String? // original-language title ("Diriliş: Ertuğrul")
  year        Int?
  description String?
  posterUrl   String?
  backdropUrl String?

  // global rating info (provider-based, always 0–10)
  globalRating     Float?
  globalRatingText String?

  // your tracking
  status       String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, ON_HOLD, DROPPED
  yourRating   Float?
  yourRatingAt DateTime?
  yourNotes    String?

  // progress (generic + type-specific optional fields)
  progressText          String? // legacy free text, kept until typed progress replaces it in the UI
  progressValue         Int? // episodes watched / pages read
  progressSeason        Int? // TV: season you're in
  progressEpisode       Int? // TV: episode within that season
  progressTotalOverride Int? // user-set total (e.g. a dub with a different episode split)
  completedSeasonCount  Int? // seasons that existed when you marked it COMPLETED (airing baseline)
  rewatchCount          Int     @default(0) // times rewatched/reread after the first completion

  genres    String? // JSON string array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Franchise/series grouping ("card stack") — best-effort, provider-sourced.
  // Movies: TMDB belongs_to_collection. Books/TV: left null, no reliable signal.
  // Anime uses franchiseId below instead.
  collectionId      String?
  collectionName    String?
  collectionSource  String? // "tmdb" | "anilist"
  tmdbId            String? // cross-provider TMDB record for AniList anime
  tmdbMediaType     String? // MOVIE | TV
  anilistPopularity Int?

  // Anime franchise: the original series this entry belongs under.
  franchiseId       String?
  franchiseOverride Boolean @default(false)
  franchiseRole     String? // MAIN | MOVIE | OVA | ONA | SPECIAL
  franchiseOrder    Int? // position within the franchise (airing order)

  // Origin + region (regional categories). region is derived from
  // countryOfOrigin; regionOverride is the user's "Move to…" choice.
  countryOfOrigin  String? // ISO 3166-1 alpha-2 ("TR", "PK", "JP")
  originalLanguage String? // ISO 639-1 ("tr", "ur", "ja")
  region           String? // TR | PK | KR | EU | null (= general TV/Movies)
  regionOverride   String? // same values, or "NONE" to force general

  creator     String? // display: director / creator / author(s)
  seasons     Int? // TV: number of seasons
  pageCount   Int? // books
  isbn        String? // books (ISBN-13 when available)
  releaseDate DateTime? // movies: theatrical; series: first air date

  // Airing / release snapshot, refreshed by the daily job.
  airStatus          String? // RETURNING | ENDED | CANCELED | AIRING | UPCOMING | IN_PRODUCTION
  lastAiredSeason    Int?
  lastAiredEpisode   Int?
  lastAiredDate      DateTime?
  nextAirSeason      Int?
  nextAirEpisode     Int?
  nextAirDate        DateTime?
  airedEpisodeCount  Int? // episodes aired so far (ongoing series)
  announcedNext      String? // "Season 5" / sequel title, when announced
  announcedNextDate  DateTime?
  digitalReleaseDate DateTime? // movies still in cinemas

  // Extra audience / critic scores (KNOWN_ISSUES #49). IMDb, Rotten Tomatoes
  // and Metacritic come from OMDb (needs OMDB_API_KEY); MyAnimeList via Jikan.
  imdbId          String?
  imdbRating      Float? // 0–10
  imdbVotes       Int?
  rtCritics       Int? // Rotten Tomatoes Tomatometer, 0–100 %
  metascore       Int? // Metacritic, 0–100
  malId           Int?
  malScore        Float? // 0–10
  malVotes        Int?
  scoresCheckedAt DateTime?

  // When provider metadata was last fetched (also set when it found nothing,
  // so library loads never re-fetch).
  metaCheckedAt DateTime?
  airCheckedAt  DateTime?

  franchise         Franchise?           @relation(fields: [franchiseId], references: [id])
  listItems         ListItem[]
  credits           Credit[]
  tags              MediaTag[]
  TierEntry         TierEntry[]
  episodeGuide      Episode[]
  episodeGuideCache EpisodeSeasonCache[]

  @@unique([provider, providerId])
  @@index([collectionId])
  @@index([franchiseId])
  @@index([mediaType, region])
  @@index([tmdbId, tmdbMediaType])
}

// One anime franchise, keyed by the AniList id of its original series. Holds
// the OG series' artwork so the tile works even if only a movie is tracked.
model Franchise {
  id              String   @id // AniList media id of the root series
  title           String
  nativeTitle     String?
  posterUrl       String?
  bannerUrl       String?
  countryOfOrigin String?
  status          String? // AniList status of the root series
  updatedAt       DateTime @updatedAt

  items MediaItem[]
  links FranchiseLink[]
}

model Episode {
  id            String    @id @default(cuid())
  mediaId       String
  seasonNumber  Int
  episodeNumber Int
  name          String
  overview      String?
  airDate       DateTime?
  runtime       Int?
  stillUrl      String?
  updatedAt     DateTime  @updatedAt

  // Phase 2 (expand): mirrors mediaId; Work.id is the MediaItem id it was created from.
  workId   String?
  seasonId String?

  media    MediaItem         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  work     Work?             @relation(fields: [workId], references: [id], onDelete: Cascade)
  season   Season?           @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  progress EpisodeProgress[]

  @@unique([mediaId, seasonNumber, episodeNumber])
  @@index([mediaId, seasonNumber, episodeNumber])
  @@index([workId])
}

model EpisodeSeasonCache {
  mediaId      String
  seasonNumber Int
  checkedAt    DateTime @default(now())

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, seasonNumber])
}

// A person or studio, keyed "<source>:<externalId>" ("tmdb:525", "anilist-studio:569").
model Contributor {
  id       String   @id
  name     String
  kind     String // PERSON | STUDIO
  imageUrl String?
  credits  Credit[]
}

model Credit {
  id            String  @id @default(cuid())
  mediaId       String
  contributorId String
  role          String // DIRECTOR | CREATOR | AUTHOR | CAST | STUDIO
  character     String?
  order         Int     @default(0)

  // Phase 2 (expand): mirrors mediaId.
  workId String?

  media       MediaItem   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  work        Work?       @relation(fields: [workId], references: [id], onDelete: Cascade)
  contributor Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([mediaId, contributorId, role])
  @@index([contributorId])
  @@index([workId])
}

// Personal tags ("comfort watch") and moods.
model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  kind      String     @default("TAG") // TAG | MOOD
  color     String?
  createdAt DateTime   @default(now())
  items     MediaTag[]
}

model MediaTag {
  mediaId String
  tagId   String
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
}

model CustomList {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverColor  String? // hex or css token
  kind        String   @default("LIST") // LIST | TOP10 (one Top 10 per media type)
  mediaType   String? // set for TOP10 lists
  isRanked    Boolean  @default(false) // numbered order matters (TOP10 is always ranked)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items  ListItem[]
  shares CustomListShare[]

  @@index([kind, mediaType])
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  mediaId   String
  order     Int      @default(0)
  note      String? // why it's on the list / why it ranks here
  createdAt DateTime @default(now())

  list  CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media MediaItem  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
}

model CustomListShare {
  id        String   @id @default(cuid())
  listId    String   @unique
  tokenHash String   @unique
  createdAt DateTime @default(now())

  list CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
}

// Tier lists: drag items into S / A / B / C / D rows (KNOWN_ISSUES #67).
model TierList {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  entries     TierEntry[]
}

model TierEntry {
  id         String @id @default(cuid())
  tierListId String
  mediaId    String
  tier       String // S | A | B | C | D
  order      Int    @default(0)

  tierList TierList  @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  media    MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([tierListId, mediaId])
}

model SuggestionDismissal {
  id         String   @id @default(cuid())
  provider   String
  providerId String
  mediaType  String?
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([mediaType])
}

// --- Auth (single-account: PIN unlock on trusted devices, email OTP to trust a new device) ---

model AccountConfig {
  id                 Int       @id @default(1)
  email              String
  pinSaltHex         String
  pinHashHex         String
  failedPinAttempts  Int       @default(0)
  lockedUntil        DateTime?
  showAdultContent   Boolean   @default(false)
  spoilerShield      Boolean   @default(false)
  watchCountry       String?
  defaultMediaStatus String    @default("PLANNED")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model TrustedDevice {
  id            String   @id @default(cuid()) // stored in long-lived httpOnly cookie `gr_device`
  label         String?
  userAgent     String?
  verifiedEmail String? // email this device proved ownership of via OTP; required to bootstrap
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid()) // stored in httpOnly cookie `gr_session`
  deviceId  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model OtpCode {
  id              String    @id @default(cuid())
  codeHash        String
  email           String // the email this code was actually sent to; binds /otp/verify's result
  pendingDeviceId String // stored in short-lived httpOnly cookie `gr_pending_device`
  expiresAt       DateTime
  consumedAt      DateTime?
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now())
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   String    @default("{}") // JSON
  status    String    @default("pending") // pending | running | parked
  runAfter  DateTime  @default(now())
  claimedAt DateTime?
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())

  @@index([status, runAfter])
}

// ---------------------------------------------------------------------------
// Phase 2 (expand): catalog / tracking split. MediaItem stays the source of
// truth and is dual-written into these tables (see services/works.ts). A Work
// reuses the id of the MediaItem it mirrors, so every legacy mediaId is also a
// valid workId.
// ---------------------------------------------------------------------------

model Work {
  id            String   @id @default(uuid())
  type          String // movie | tv | anime | book
  title         String
  originalTitle String?
  year          Int?
  country       String? // ISO 3166-1 alpha-2
  language      String? // ISO 639-1
  overview      String?
  posterUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  externalIds    ExternalId[]
  seasons        Season[]
  episodes       Episode[]
  credits        Credit[]
  libraryEntry   LibraryEntry?
  franchiseLinks FranchiseLink[]

  @@index([type])
}

model ExternalId {
  id         String  @id @default(uuid())
  workId     String
  source     String // tmdb | anilist | googlebooks | imdb | mal | manual
  externalId String // tmdb ids are "movie:<id>" / "tv:<id>": TMDB numbers its movies and series separately
  confidence Float   @default(1.0)
  isPrimary  Boolean @default(false)
  work       Work    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([workId])
}

model Season {
  id       String    @id @default(uuid())
  workId   String
  number   Int
  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([workId, number])
}

// Your tracking state for a Work. One entry per Work; rewatches are a counter.
model LibraryEntry {
  id           String    @id @default(uuid())
  workId       String    @unique
  status       String // planned | in_progress | completed | on_hold | dropped
  score        Float?
  notes        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  rewatchCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  work            Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  episodeProgress EpisodeProgress[]
  watchEvents     WatchEvent[]

  @@index([status])
}

model EpisodeProgress {
  id             String       @id @default(uuid())
  libraryEntryId String
  episodeId      String
  watchedAt      DateTime     @default(now())
  libraryEntry   LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  episode        Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([libraryEntryId, episodeId])
}

model WatchEvent {
  id             String       @id @default(uuid())
  libraryEntryId String
  type           String // started | completed | dropped | rewatched
  occurredAt     DateTime     @default(now())
  libraryEntry   LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)

  @@index([libraryEntryId, occurredAt])
}

// Franchise membership belongs to the catalog work, not to your tracking state.
model FranchiseLink {
  id          String    @id @default(uuid())
  workId      String
  franchiseId String
  relation    String // main | movie | ova | ona | special (sequel/prequel/spin-off need provider data)
  order       Int?
  work        Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@unique([workId, franchiseId])
  @@index([franchiseId, order])
}
